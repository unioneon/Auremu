<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Aemu — Android на вашем ПК" Width="1260" Height="900" MinWidth="440" MinHeight="640" WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="CanResize" FontFamily="Segoe UI" Foreground="#F5F4FF">
 <Window.Resources>
  <SolidColorBrush x:Key="Muted" Color="#A5ABC6"/>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style TargetType="ScrollBar"><Setter Property="Width" Value="7"/><Setter Property="Background" Value="Transparent"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Track x:Name="PART_Track" IsDirectionReversed="True"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#434A69" CornerRadius="3" Margin="1"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton></Track></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="#E8E6FF"/><Setter Property="Background" Value="#282C46"/><Setter Property="BorderBrush" Value="#414762"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="18,12"/><Setter Property="FontSize" Value="14"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,0,10,8"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.6"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.4"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="#C6AEFF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Foreground" Value="#17132D"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Background"><Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#C5A6FF"/><GradientStop Color="#9370F8" Offset="1"/></LinearGradientBrush></Setter.Value></Setter></Style>
  <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Margin" Value="0,4"/><Setter Property="Padding" Value="14,15"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#171D30"/><Setter Property="Foreground" Value="#F5F4FF"/><Setter Property="CaretBrush" Value="White"/><Setter Property="BorderBrush" Value="#454D70"/><Setter Property="Padding" Value="12"/><Setter Property="FontSize" Value="14"/><Setter Property="Margin" Value="0,6,0,16"/></Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#F5F4FF"/><Setter Property="Padding" Value="12,9"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Item" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="6"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="#494180"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="#35334F"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ComboBox"><Setter Property="FontSize" Value="14"/><Setter Property="Padding" Value="12"/><Setter Property="Margin" Value="0,6,0,16"/><Setter Property="Foreground" Value="#F5F4FF"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="#20273C" BorderBrush="#454D70" BorderThickness="1" CornerRadius="12"><TextBlock Text="⌄" Foreground="#B6A4F2" HorizontalAlignment="Right" Margin="0,0,14,0" VerticalAlignment="Center"/></Border></ControlTemplate></ToggleButton.Template></ToggleButton><ContentPresenter Margin="12,12,32,12" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/><Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False"><Border Background="#20273C" BorderBrush="#605682" BorderThickness="1" CornerRadius="12" Padding="6" MinWidth="180" MaxHeight="320"><ScrollViewer CanContentScroll="True"><StackPanel IsItemsHost="True"/></ScrollViewer></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Border x:Name="Outer" CornerRadius="42" BorderThickness="1.5" BorderBrush="#72769F">
  <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#111625"/><GradientStop Color="#171D30" Offset="0.6"/><GradientStop Color="#111521" Offset="1"/></LinearGradientBrush></Border.Background>
  <Grid Margin="16">
   <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="36"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid x:Name="TitleBar" Background="Transparent">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0"><TextBlock Text="⬡" FontSize="32" Foreground="#B59AFF" VerticalAlignment="Center"/><TextBlock Text="Aemu" FontSize="23" FontWeight="SemiBold" Margin="10,0" VerticalAlignment="Center"/><Border Background="#28263F" CornerRadius="6" Padding="7,3" VerticalAlignment="Center"><TextBlock Text="PREVIEW" FontSize="9" Foreground="#C3ADFF"/></Border></StackPanel>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="Minimize" Content="—" Background="Transparent" BorderThickness="0" Padding="13,8"/><Button x:Name="Maximize" Content="□" Background="Transparent" BorderThickness="0" Padding="13,8"/><Button x:Name="Close" Content="✕" Background="Transparent" BorderThickness="0" Padding="13,8"/></StackPanel>
   </Grid>
   <Grid Grid.Row="1" Margin="8,12,8,0">
    <Grid.ColumnDefinitions><ColumnDefinition x:Name="NavColumn" Width="186"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <DockPanel x:Name="Sidebar" Margin="4,0,20,0">
     <StackPanel DockPanel.Dock="Bottom"><TextBlock Text="OFFICIAL SDK ENGINE" Foreground="#747D9D" FontSize="9" Margin="14,15"/><Button x:Name="SdkShortcut" Style="{StaticResource Nav}" Content="↻   SDK Manager"/></StackPanel>
     <StackPanel><Button x:Name="HomeNav" Style="{StaticResource Nav}" Content="⌂   Главная"/><Button x:Name="DevicesNav" Style="{StaticResource Nav}" Content="▱   Эмуляторы"/><Button x:Name="SdkNav" Style="{StaticResource Nav}" Content="▧   Образы SDK"/><Button x:Name="ApkNav" Style="{StaticResource Nav}" Content="⇧   Установка APK"/><Button x:Name="SettingsNav" Style="{StaticResource Nav}" Content="⚙   Настройки"/></StackPanel>
    </DockPanel>
    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,10"><StackPanel x:Name="Content"/></ScrollViewer>
   </Grid>
   <DockPanel Grid.Row="2" Margin="18,4"><Button x:Name="LogToggle" DockPanel.Dock="Right" Content="Журнал ↗" Padding="9,4" FontSize="11" Margin="10,0,0,0" Background="Transparent" BorderThickness="0"/><Button x:Name="Cancel" DockPanel.Dock="Right" Content="Отмена" Visibility="Collapsed" Padding="9,4" FontSize="11" Margin="10,0,0,0"/><Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="#A18AFF" Margin="0,0,9,0"/><TextBlock x:Name="Status" Text="Проверяем подключение SDK…" Foreground="#A5ABC6" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/></DockPanel>
   <TextBox x:Name="LogBox" Grid.Row="3" Visibility="Collapsed" Height="140" IsReadOnly="True" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="16,4"/>
  </Grid>
 </Border>
</Window>
